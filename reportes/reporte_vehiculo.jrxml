	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="placa" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    v.placa, v.marca, v.modelo, v.anio, v.tipo AS tipo_vehiculo,
    s.fecha, s.tipo AS tipo_servicio, s.costo, s.pagado
FROM vehiculos v
LEFT JOIN servicios s ON s.vehiculo_id = v.id
WHERE TRIM(UPPER(v.placa)) = TRIM(UPPER($P{placa}))
    
]]>
	</queryString>
