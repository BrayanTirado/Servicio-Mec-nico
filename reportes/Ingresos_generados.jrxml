<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Ingresos_generados" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e3b158d9-92b2-42dc-a5c0-5b82d4023adf">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="reportes"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="fecha_inicio" class="java.util.Date"/>
	<parameter name="fecha_fin" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT 
    fecha,
    SUM(costo) AS ingresos_totales
FROM 
    servicios
WHERE 
    fecha BETWEEN $P{fecha_inicio} AND $P{fecha_fin}
GROUP BY 
    fecha
ORDER BY 
    fecha]]>
	</queryString>
	<field name="fecha" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.name" value="fecha"/>
		<property name="com.jaspersoft.studio.field.label" value="fecha"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="servicios"/>
	</field>
	<field name="ingresos_totales" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ingresos_totales"/>
		<property name="com.jaspersoft.studio.field.label" value="ingresos_totales"/>
	</field>
	<group name="fechas_grupo">
		<groupExpression><![CDATA[$F{fecha}]]></groupExpression>
	</group>
