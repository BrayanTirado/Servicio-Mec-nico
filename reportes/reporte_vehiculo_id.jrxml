	<parameter name="vehiculo_id" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT servicios.*, vehiculos.*
FROM servicios
JOIN vehiculos ON servicios.vehiculo_id = vehiculos.id
WHERE servicios.vehiculo_id = $P{vehiculo_id}]]>
	</queryString>
