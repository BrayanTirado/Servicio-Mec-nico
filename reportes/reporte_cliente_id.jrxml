	<parameter name="cliente_id" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT servicios.*,
	clientes.*
FROM servicios
	JOIN clientes ON 
	 servicios.cliente_id = clientes.id 
WHERE 
	 servicios.cliente_id = $P{cliente_id}]]>
	</queryString>
