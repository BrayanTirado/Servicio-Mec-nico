	<parameter name="documento" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    servicios.*, 
    clientes.*
FROM 
    servicios
JOIN 
    clientes ON servicios.cliente_id = clientes.id
WHERE 
    clientes.documento = $P{documento}]]>
	</queryString>
